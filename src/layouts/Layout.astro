---
const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
    <style is:global>
        :root {
            --pi-purple: #1e0a27;
            --pi-gradient: linear-gradient(135deg, #1e0a27 0%, #423f88 100%);
            --pi-gold: linear-gradient(90deg, #f4af47 0%, #fab44b 100%);
        }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            margin: 0;
            background-color: var(--pi-purple);
        }
        .text-gradient {
            background: var(--pi-gold);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero-bg {
            background: var(--pi-gradient);
        }
    </style>
</head>
<body class="text-white selection:bg-yellow-500 selection:text-purple-900 overflow-x-hidden">
    <slot />
</body>
</html>
