---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pi 派币中文网 - 全球领先的移动社交区块链社区" description="Pi 派币官方中文社区，为您提供最新的 Pi Network 资讯、技术文档、生态展示和挖矿指南。">
    <!-- Navigation -->
    <header class="fixed w-full z-50 bg-[#1e0a27]/80 backdrop-blur-md border-b border-white/5">
        <nav class="container mx-auto px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="text-3xl font-black text-[#f4af47]">π</span>
                <span class="text-xl font-bold tracking-tighter">PI 派币中文网</span>
            </div>
            <div class="hidden lg:flex items-center gap-8 text-sm font-medium uppercase tracking-widest text-gray-300">
                <a href="/" class="hover:text-white transition-colors">首页</a>
                <a href="/whitepaper" class="hover:text-white transition-colors">技术白皮书</a>
                <a href="/ecosystem" class="hover:text-white transition-colors">生态节点</a>
                <a href="/blog" class="hover:text-white transition-colors">中文社区</a>
            </div>
            <a href="#download" class="bg-[#f4af47] text-[#1e0a27] px-6 py-2 rounded-full font-bold text-sm hover:bg-[#fab44b] transition-all shadow-lg shadow-orange-500/20">
                下载 APP
            </a>
        </nav>
    </header>

    <!-- Hero Section -->
    <section class="hero-bg pt-40 pb-32 px-6 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-10"></div>
        <div class="container mx-auto text-center relative z-10">
            <h1 class="text-5xl md:text-8xl font-black mb-8 leading-[1.1] tracking-tight">
                首种可以在手机上<br />
                <span class="text-gradient">轻松挖掘的货币</span>
            </h1>
            <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto mb-12 leading-relaxed">
                让加密货币真正走向大众。通过手机即可零成本参与，无需消耗额外电量，开启你的 Web3 社交资产之旅。
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-6">
                <a href="/blog" class="bg-[#f4af47] text-[#1e0a27] px-12 py-5 rounded-2xl font-black text-xl hover:scale-105 transition-transform shadow-2xl shadow-orange-500/30">
                    立即开启同步
                </a>
                <a href="#" class="border-2 border-white/20 hover:bg-white/10 px-12 py-5 rounded-2xl font-black text-xl transition-all">
                    了解技术原理
                </a>
            </div>
        </div>
    </section>

    <!-- Feature Grid (Copy of MinePi) -->
    <section class="bg-black py-24 px-6 border-y border-white/5">
        <div class="container mx-auto grid md:grid-cols-3 gap-16 text-center">
            <div class="group">
                <div class="text-5xl mb-6 grayscale group-hover:grayscale-0 transition-all">🛡️</div>
                <h3 class="text-2xl font-bold mb-4 text-white">去中心化</h3>
                <p class="text-gray-400 leading-relaxed">安全、不可篡改、可互操作的数字货币，保护全球用户的每一分资产。</p>
            </div>
            <div class="group">
                <div class="text-5xl mb-6 grayscale group-hover:grayscale-0 transition-all">📱</div>
                <h3 class="text-2xl font-bold mb-4 text-white">移动优先</h3>
                <p class="text-gray-400 leading-relaxed">首创移动端挖掘技术，不占内存、不发热，手机即是全功能节点。</p>
            </div>
            <div class="group">
                <div class="text-5xl mb-6 grayscale group-hover:grayscale-0 transition-all">🌍</div>
                <h3 class="text-2xl font-bold mb-4 text-white">全球共识</h3>
                <p class="text-gray-400 leading-relaxed">数千万 Pioneer 共同构建，是目前全球覆盖面最广的 Web3 社区。</p>
            </div>
        </div>
    </section>

    <!-- Auto-Sync Blog Preview -->
    <section class="py-24 px-6 bg-[#1e0a27]">
        <div class="container mx-auto">
            <div class="flex items-end justify-between mb-12 border-l-4 border-[#f4af47] pl-6">
                <div>
                    <h2 class="text-4xl font-black uppercase">最新资讯</h2>
                    <p class="text-gray-400 mt-2">实时同步自 MinePi.com 官方博客</p>
                </div>
                <a href="/blog" class="text-[#f4af47] font-bold hover:underline">查看全部 →</a>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <div class="bg-white/5 rounded-3xl p-8 border border-white/10 hover:border-orange-500/30 transition-all group cursor-pointer">
                    <div class="text-[#f4af47] text-sm font-bold mb-4">2026.03.16 · 同步中</div>
                    <h4 class="text-2xl font-bold mb-4 leading-tight group-hover:text-orange-400">机器人正在抓取并翻译最新文章...</h4>
                    <p class="text-gray-400 text-sm leading-relaxed mb-6">我们正在配置全自动翻译引擎，届时 MinePi 官网的每一条更新都将以最快的速度呈现为中文版本。</p>
                    <div class="w-full h-1 bg-white/10 rounded-full overflow-hidden">
                        <div class="w-2/3 h-full bg-gradient-to-r from-orange-400 to-yellow-500 animate-pulse"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-black py-16 px-6 text-center border-t border-white/5">
        <div class="mb-8">
            <span class="text-4xl font-black text-[#f4af47]">π</span>
        </div>
        <p class="text-gray-500 text-sm tracking-widest uppercase mb-4">© 2026 PI 派币中文社区 · 非官方附属机构</p>
        <div class="flex justify-center gap-6 text-gray-400 text-xs">
            <a href="#" class="hover:text-white">隐私政策</a>
            <a href="#" class="hover:text-white">免责声明</a>
            <a href="#" class="hover:text-white">联系我们</a>
        </div>
    </footer>
</Layout>
