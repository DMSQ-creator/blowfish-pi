---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pi 派币中文网 | 全球领先移动社交区块链">
    <!-- Navbar -->
    <nav class="fixed w-full z-50 px-6 py-4 bg-[#0f021a]/60 backdrop-blur-xl border-b border-white/5">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-gradient-to-br from-[#f4af47] to-[#fab44b] rounded-full flex items-center justify-center shadow-lg shadow-orange-500/20">
                    <span class="text-[#1e0a27] font-black text-2xl">π</span>
                </div>
                <span class="text-xl font-black tracking-tight uppercase">Pi 派币中文网</span>
            </div>
            <div class="hidden md:flex gap-10 text-xs font-bold tracking-widest text-gray-400 uppercase">
                <a href="/" class="hover:text-[#f4af47] transition-colors">首页</a>
                <a href="#" class="hover:text-[#f4af47] transition-colors">技术文档</a>
                <a href="#" class="hover:text-[#f4af47] transition-colors">生态节点</a>
                <a href="#" class="hover:text-[#f4af47] transition-colors">中文社区</a>
            </div>
            <button class="bg-[#f4af47] text-[#1e0a27] px-6 py-2 rounded-full font-black text-xs hover:bg-white transition-all shadow-xl shadow-orange-500/10">
                立即参与
            </button>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
        <!-- Background Accents (復刻 MinePi) -->
        <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-[#593b8b]/30 blur-[150px] rounded-full animate-pulse"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] bg-[#423f88]/20 blur-[150px] rounded-full animate-pulse"></div>
        
        <div class="relative z-10 text-center px-6 max-w-5xl mx-auto">
            <div class="inline-block px-4 py-1 rounded-full bg-white/5 border border-white/10 text-[#f4af47] text-[10px] font-black tracking-[0.2em] uppercase mb-8 animate-bounce">
                Stanford Ph.D 团队打造
            </div>
            <h1 class="text-6xl md:text-9xl font-black mb-10 leading-[1] tracking-tighter">
                首个移动端<br />
                <span class="bg-gradient-to-r from-[#f4af47] via-[#fab44b] to-[#f4af47] bg-clip-text text-transparent">区块链网络</span>
            </h1>
            <p class="text-xl md:text-2xl text-gray-400 max-w-2xl mx-auto mb-12 leading-relaxed font-medium">
                Pi 让加密货币挖掘变得简单。突破性技术让您在手机上零成本开启 Web3 资产之旅，已有超过数千万 Pioneer 活跃。
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-6">
                <button class="bg-[#f4af47] text-[#1e0a27] px-14 py-6 rounded-2xl font-black text-xl hover:scale-105 transition-transform shadow-2xl shadow-orange-500/40">
                    立即开启中文版
                </button>
                <button class="border-2 border-white/10 hover:bg-white/5 px-14 py-6 rounded-2xl font-black text-xl transition-all">
                    了解挖矿机制
                </button>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="py-32 bg-black/40 border-y border-white/5 relative">
        <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-3 gap-20">
            <div class="text-center group">
                <div class="text-[#f4af47] text-6xl font-black mb-4 transition-transform group-hover:scale-110">55M+</div>
                <div class="text-xs font-black tracking-[0.3em] text-gray-500 uppercase">全球活跃矿工</div>
            </div>
            <div class="text-center group border-x border-white/5 px-4">
                <div class="text-white text-6xl font-black mb-4 transition-transform group-hover:scale-110">100%</div>
                <div class="text-xs font-black tracking-[0.3em] text-gray-500 uppercase">去中心化愿景</div>
            </div>
            <div class="text-center group">
                <div class="text-[#f4af47] text-6xl font-black mb-4 transition-transform group-hover:scale-110">FREE</div>
                <div class="text-xs font-black tracking-[0.3em] text-gray-500 uppercase">零成本准入门槛</div>
            </div>
        </div>
    </section>

    <!-- Content Blocks (Blog Sync Ready) -->
    <section class="py-32 px-6 bg-[#0f021a]">
        <div class="max-w-7xl mx-auto">
            <div class="flex items-center justify-between mb-20">
                <h2 class="text-5xl font-black tracking-tighter uppercase">资讯同步 <span class="text-[#f4af47]">Blog</span></h2>
                <div class="h-px bg-white/10 flex-1 mx-10"></div>
                <a href="#" class="text-gray-400 font-bold hover:text-white transition-colors">查看历史记录 →</a>
            </div>
            
            <div class="grid md:grid-cols-2 gap-10">
                <div class="p-10 rounded-[40px] bg-gradient-to-br from-white/5 to-transparent border border-white/10 hover:border-orange-500/20 transition-all group">
                    <div class="w-12 h-12 rounded-2xl bg-white/5 flex items-center justify-center mb-8 group-hover:bg-[#f4af47]/10 transition-colors text-gray-500 group-hover:text-[#f4af47]">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <h3 class="text-3xl font-black mb-6 leading-tight">全自动抓取引擎<br />正在同步最新文章...</h3>
                    <p class="text-gray-400 leading-relaxed text-lg">我们的后台脚本 `pi_sync.py` 正在监听斯坦福官方博客，即将为您呈现第一批翻译好的中文资讯。</p>
                </div>
                
                <div class="p-10 rounded-[40px] border border-white/5 hover:bg-white/5 transition-all cursor-pointer flex flex-col justify-between">
                    <h3 class="text-2xl font-bold mb-4">为什么 Pi 派币改变了加密货币的逻辑？</h3>
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-px bg-[#f4af47]"></div>
                        <span class="text-[#f4af47] font-black text-xs uppercase tracking-widest">即将同步</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-20 text-center border-t border-white/5">
        <div class="text-[#f4af47] font-black text-3xl mb-6">π</div>
        <p class="text-gray-600 text-[10px] font-bold tracking-[0.5em] uppercase">© 2026 PI 派币中文社区网 · 开启 Web3 社交时代</p>
    </footer>
</Layout>
